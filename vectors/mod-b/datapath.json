      ]
    },
    {
      "name": "s16x1-extreme-values",
      "why": "The largest coefficients against the largest 16-bit samples, both signs. 2^17 = 131072, 2^15 = 32768, 2^32 = 4294967296, 2^33 = 8589934592.",
      "profile": "s16x1",
      "config": {"filters": [{"0": [-131072, 131071]}], "head": [1], "rectifier": 0, "pool": 1, "score_shift": 0},
      "frames": [[32767], [-32768], [1]],
      "worked": [
        "score[i] = -131072*x[i-1] + 131071*x[i]",
        "i=0: 0 + 131071*32767 = (2^17 - 1)(2^15 - 1) = 2^32 - 2^17 - 2^15 + 1 = 4294967296 - 131072 - 32768 + 1 = 4294803457",
        "i=1: -131072*32767 + 131071*(-32768) = -(2^32 - 2^17) - (2^32 - 2^15) = -2^33 + 131072 + 32768 = -8589770752",
        "i=2: -131072*(-32768) + 131071*1 = 2^32 + 131071 = 4295098367"
      ],
      "records": [
        {"index": 0, "epoch": 0, "flags": 0, "score": 4294803457},
        {"index": 1, "epoch": 0, "flags": 0, "score": -8589770752},
