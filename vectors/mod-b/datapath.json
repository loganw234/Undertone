      "profile": "s16x1",
      "config": {"filters": [{"0": [1, 2, 3]}], "head": [1], "rectifier": 0, "pool": 1, "score_shift": 0},
      "frames": [[0], [1], [0], [0], [0]],
      "worked": [
        "i=0: 3*0 = 0",
        "i=1: 1*0 + 2*0 + 3*1 = 3",
        "i=2: 1*0 + 2*1 + 3*0 = 2",
        "i=3: 1*1 + 2*0 + 3*0 = 1",
        "i=4: 1*0 + 2*0 + 3*0 = 0"
