    {
      "name": "s16x1-abs-pool-head-shift",
      "why": "Every stage at once: two filters, the absolute value, a pool of 3, a head of (1, -3) and a shift of 1. The head sums are negative, and four of them are odd, so the shift's rounding shows: floor(-13/2) = -7, where rounding toward zero would give -6.",
      "profile": "s16x1",
      "config": {"filters": [{"0": [1, -2]}, {"0": [3, 1]}], "head": [1, -3], "rectifier": 1, "pool": 3, "score_shift": 1},
      "frames": [[2], [-1], [4], [0], [-3], [5]],
      "worked": [
        "y0[i] = 1*x[i-1] - 2*x[i]:  i=0: 0 - 4 = -4;  i=1: 2 + 2 = 4;  i=2: -1 - 8 = -9;  i=3: 4 - 0 = 4;  i=4: 0 + 6 = 6;  i=5: -3 - 10 = -13",
        "y1[i] = 3*x[i-1] + 1*x[i]:  i=0: 0 + 2 = 2;  i=1: 6 - 1 = 5;  i=2: -3 + 4 = 1;  i=3: 12 + 0 = 12;  i=4: 0 - 3 = -3;  i=5: -9 + 5 = -4",
        "r0 = |y0| = 4, 4, 9, 4, 6, 13;  r1 = |y1| = 2, 5, 1, 12, 3, 4",
        "z0 (last 3 of r0): 4;  4+4 = 8;  4+4+9 = 17;  4+9+4 = 17;  9+4+6 = 19;  4+6+13 = 23",
        "z1 (last 3 of r1): 2;  2+5 = 7;  2+5+1 = 8;  5+1+12 = 18;  1+12+3 = 16;  12+3+4 = 19",
        "a = z0 - 3*z1:  4 - 6 = -2;  8 - 21 = -13;  17 - 24 = -7;  17 - 54 = -37;  19 - 48 = -29;  23 - 57 = -34",
        "score = floor(a / 2):  -1;  -7;  -4;  -19;  -15;  -17"
      ],
      "records": [
        {"index": 0, "epoch": 0, "flags": 0, "score": -1},
        {"index": 1, "epoch": 0, "flags": 0, "score": -7},
        {"index": 2, "epoch": 0, "flags": 0, "score": -4},
        {"index": 3, "epoch": 0, "flags": 0, "score": -19},
        {"index": 4, "epoch": 0, "flags": 0, "score": -15},
        {"index": 5, "epoch": 0, "flags": 0, "score": -17}
      ]
